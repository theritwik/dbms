from typing import List, Dict, Optional, Tuple

class Attribute:
    def __init__(self, name: str, is_key: bool = False, is_multivalued: bool = False):
        self.name = name
        self.is_key = is_key
        self.is_multivalued = is_multivalued

class Entity:
    def __init__(self, name: str, attributes: List[Attribute]):
        self.name = name
        self.attributes = attributes

class Relationship:
    def __init__(self, name: str, entities: List[Tuple['Entity', str]], attributes: List[Attribute] = []):
        """
        entities: List of tuples (Entity, cardinality) where cardinality is '1' or 'N'
        """
        self.name = name
        self.entities = entities
        self.attributes = attributes

class ERSchemaConverter:
    def __init__(self, entities: List[Entity], relationships: List[Relationship]):
        self.entities = entities
        self.relationships = relationships

    def convert(self) -> Dict[str, Dict]:
        """
        Converts ER diagram to relational schema.
        Returns a dictionary with table names as keys and dict of columns and constraints as values.
        """
        schema = {}

        # Step 1: Convert entities
        for entity in self.entities:
            columns = []
            pk = []
            for attr in entity.attributes:
                if attr.is_multivalued:
                    # Multi-valued attribute: create separate table
                    mv_table_name = f"{entity.name}_{attr.name}"
                    schema[mv_table_name] = {
                        "columns": [f"{entity.name}ID", attr.name],
                        "primary_key": [f"{entity.name}ID", attr.name],
                        "foreign_keys": {f"{entity.name}ID": entity.name}
                    }
                else:
                    columns.append(attr.name)
                    if attr.is_key:
                        pk.append(attr.name)
            schema[entity.name] = {
                "columns": columns,
                "primary_key": pk,
                "foreign_keys": {}
            }

        # Step 2: Convert relationships
        for rel in self.relationships:
            # Determine cardinalities
            card_map = {ent.name: card for ent, card in rel.entities}
            entities = [ent for ent, _ in rel.entities]

            # Handle M:N relationship
            if list(card_map.values()).count('N') > 1:
                # Create new table with composite PK
                columns = []
                pk = []
                fks = {}
                for ent in entities:
                    pk_col = f"{ent.name}ID"
                    columns.append(pk_col)
                    pk.append(pk_col)
                    fks[pk_col] = ent.name
                # Add relationship attributes
                for attr in rel.attributes:
                    columns.append(attr.name)
                schema[rel.name] = {
                    "columns": columns,
                    "primary_key": pk,
                    "foreign_keys": fks
                }
            else:
                # For 1:1 or 1:N, add FK to appropriate entity
                # For simplicity, add FK to entity with 'N' cardinality
                one_side = [ent for ent, card in rel.entities if card == '1']
                many_side = [ent for ent, card in rel.entities if card == 'N']

                if many_side:
                    fk_entity = many_side[0]
                    pk_entity = one_side[0]
                    fk_col = f"{pk_entity.name}ID"
                    schema[fk_entity.name]["columns"].append(fk_col)
                    schema[fk_entity.name]["foreign_keys"][fk_col] = pk_entity.name
                    # Add relationship attributes to many side table
                    for attr in rel.attributes:
                        schema[fk_entity.name]["columns"].append(attr.name)
                else:
                    # 1:1 relationship - choose one side arbitrarily to hold FK
                    fk_entity = entities[0]
                    pk_entity = entities[1]
                    fk_col = f"{pk_entity.name}ID"
                    schema[fk_entity.name]["columns"].append(fk_col)
                    schema[fk_entity.name]["foreign_keys"][fk_col] = pk_entity.name
                    for attr in rel.attributes:
                        schema[fk_entity.name]["columns"].append(attr.name)

        return schema

# Example usage:

if __name__ == "__main__":
    student_attrs = [Attribute("StudentID", is_key=True), Attribute("Name"), Attribute("Age")]
    course_attrs = [Attribute("CourseID", is_key=True), Attribute("Title")]
    student = Entity("Student", student_attrs)
    course = Entity("Course", course_attrs)
    enrolls = Relationship("Enrolls", [(student, 'N'), (course, 'N')], [Attribute("Grade")])

    converter = ERSchemaConverter([student, course], [enrolls])
    schema = converter.convert()
    import pprint
    pprint.pprint(schema)
Time and Space Complexity
The conversion process is mostly linear with respect to the number of entities, attributes, and relationships.
Time Complexity: O(E + R + A), where E = number of entities, R = number of relationships, A = total attributes.
Space Complexity: O(E + R + A) for storing the schema.
Edge Cases Discussion
Entities with composite keys: Ensure all key attributes are included in PK.
Weak entities: Must include identifying entity's PK as FK.
Multi-valued attributes: Always create separate tables.
Relationships with attributes: Must be represented properly in relationship tables or entity tables.
Participation constraints (total/partial): Not explicitly handled in the code but important for schema constraints (e.g., NOT NULL).
Summary
This solution systematically converts an ER diagram into a relational schema by:

Mapping entities and attributes to tables and columns.
Handling keys and multi-valued attributes.
Translating relationships based on cardinality.
Representing relationship attributes.
